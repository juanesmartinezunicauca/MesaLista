# ──────────────────────────────────────────────────────
# MesaLista — Variables de entorno del backend
# Copie este archivo como .env y complete los valores
# NUNCA suba el archivo .env al repositorio
# ──────────────────────────────────────────────────────

# Aplicacion
PORT=3000
NODE_ENV=development

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mesalista?schema=public"

# Autenticacion JWT
# REQUERIDO: minimo 32 caracteres — genere uno con: openssl rand -hex 32
JWT_SECRET="CAMBIE_ESTO_POR_UN_SECRETO_SEGURO_DE_AL_MENOS_32_CHARS"
JWT_EXPIRES_IN="12h"

# CORS — Origen permitido (IP, dominio local o dominio de Vercel separado por comas)
# Ejemplo: CORS_ORIGIN="http://localhost:4200,https://mesalista.vercel.app"
CORS_ORIGIN="http://localhost:4200"

# Google OAuth 2.0 (Client ID obtenido de Google Cloud Console -> APIs y Servicios -> Credenciales)
GOOGLE_CLIENT_ID="TU_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# Hardware: Impresora termica ESC/POS
# TCP/LAN: PRINTER_INTERFACE="tcp://192.168.1.200:9100"
# USB en Windows: PRINTER_INTERFACE="printer:POS-80"
PRINTER_INTERFACE="tcp://192.168.1.200:9100"

# Despacho de Correo Electrónico (Códigos de Vinculación / Invitación)
# Opcional: Si no se configuran, el sistema opera en modo simulación/auditoría sin bloquear el flujo.
# NOTA DE PRIVACIDAD: Los correos de destino son efímeros y NO se guardan en la base de datos.
# Opción A (Resend HTTP API):
# RESEND_API_KEY="re_123456789"
# Opción B (Servidor SMTP):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="tu-correo@gmail.com"
# SMTP_PASS="tu-contraseña-de-aplicacion"
# SMTP_FROM="MesaLista POS <no-reply@mesalista.local>"

# Base de datos (para docker-compose)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mesalista
