# ──────────────────────────────────────────────────────
# MesaLista — Variables de entorno del backend
# Copie este archivo como .env y complete los valores
# NUNCA suba el archivo .env al repositorio
# ──────────────────────────────────────────────────────

# Aplicacion
PORT=3000
NODE_ENV=development

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mesalista?schema=public"

# Autenticacion JWT
# REQUERIDO: minimo 32 caracteres — genere uno con: openssl rand -hex 32
JWT_SECRET="CAMBIE_ESTO_POR_UN_SECRETO_SEGURO_DE_AL_MENOS_32_CHARS"
JWT_EXPIRES_IN="12h"

# CORS — Origen permitido (IP o dominio de la LAN del restaurante)
# Ejemplo para acceso desde dispositivos moviles de meseros en LAN:
CORS_ORIGIN="http://192.168.1.100"

# Hardware: Impresora termica ESC/POS
# TCP/LAN: PRINTER_INTERFACE="tcp://192.168.1.200:9100"
# USB en Windows: PRINTER_INTERFACE="printer:POS-80"
PRINTER_INTERFACE="tcp://192.168.1.200:9100"

# Base de datos (para docker-compose)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mesalista
