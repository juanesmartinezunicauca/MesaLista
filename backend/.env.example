# ──────────────────────────────────────────────────────
# MesaLista — Variables de entorno del backend
# Copie este archivo como .env y complete los valores reales
# NUNCA suba el archivo .env al repositorio
# ──────────────────────────────────────────────────────

# Aplicación
PORT=3000
NODE_ENV=development

# Base de datos (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mesalista?schema=public"

# Autenticación JWT
# REQUERIDO: mínimo 32 caracteres seguros
JWT_SECRET="CAMBIE_ESTO_POR_UN_SECRETO_SEGURO_DE_AL_MENOS_32_CHARS"
JWT_EXPIRES_IN="12h"

# CORS — Orígenes permitidos separados por comas
CORS_ORIGIN="http://localhost:4200,https://mesa-lista-virid.vercel.app"

# URL base del Frontend (para armado de enlaces directos de activación)
FRONTEND_URL="https://mesa-lista-virid.vercel.app"

# Google OAuth 2.0 (Client ID obtenido en Google Cloud Console)
GOOGLE_CLIENT_ID="TU_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# Despacho de Correo Transaccional (Brevo REST API - Puerto 443 HTTPS)
# Recomendado para despliegues en la nube como Render Free
BREVO_API_KEY="xkeysib-tu-api-key-de-brevo"
BREVO_SENDER_EMAIL="tu-correo-verificado-en-brevo@gmail.com"

# Hardware: Impresora térmica ESC/POS
PRINTER_INTERFACE="tcp://192.168.1.200:9100"

# Base de datos local (para docker-compose)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mesalista

# ──────────────────────────────────────────────────────
# IAST (Interactive Application Security Testing) — Contrast Security
# Usado por: npm run start:iast
# Credenciales obtenidas en: Contrast Security Community Edition / Portal
# ──────────────────────────────────────────────────────
CONTRAST__API__URL="https://ce.contrastsecurity.com/Contrast"
CONTRAST__API__API_KEY="TU_CONTRAST_API_KEY"
CONTRAST__API__SERVICE_KEY="TU_CONTRAST_SERVICE_KEY"
CONTRAST__API__USER_NAME="tu_usuario@correo.com"
CONTRAST__APPLICATION__NAME="MesaLista-Backend"
CONTRAST__SERVER__NAME="MesaLista-Server"
CONTRAST__AGENT__LOGGER__LEVEL="INFO"
